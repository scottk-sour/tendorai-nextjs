{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "tendorai.com"
        }
      ],
      "destination": "https://www.tendorai.com/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/keep-warm",
      "schedule": "*/10 * * * *"
    }
  ]
}
